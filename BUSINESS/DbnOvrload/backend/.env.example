# ─── Core ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:5173

# ─── Database ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dbnovrload?schema=public"

# ─── Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ─── Token engine ──────────────────────────────────────────────────────────
# Master secret used to derive per-venue rotating entrance TOTP secrets.
TOTP_MASTER_SECRET=change-me-too-32-bytes-minimum-secret
# Seconds a single-use redemption token stays valid once unlocked.
VOUCHER_TOKEN_TTL_SECONDS=60
# Seconds an entrance QR TOTP step lasts.
ENTRANCE_TOTP_STEP_SECONDS=60

# ─── Stitch (Capitec Pay) ──────────────────────────────────────────────────
# https://docs.stitch.money/authentication/client-tokens  (scope: client_paymentrequest)
STITCH_CLIENT_ID=
STITCH_CLIENT_SECRET=
STITCH_TOKEN_URL=https://secure.stitch.money/connect/token
STITCH_API_URL=https://api.stitch.money/v2
# Whitelisted with Stitch; receives ?id&status&externalReference after checkout.
STITCH_REDIRECT_URI=http://localhost:5173/membership/return
# Shared secret Stitch signs webhooks with (configure in the Stitch dashboard).
STITCH_WEBHOOK_SECRET=
# Beneficiary (DbnOvrload) account that membership fees settle into.
STITCH_BENEFICIARY_NAME="DbnOvrload Pty Ltd"
STITCH_BENEFICIARY_BANK=capitec
STITCH_BENEFICIARY_ACCOUNT=0000000000

# ─── Promoter reward webhooks (Slack / Discord) ────────────────────────────
PROMOTER_WEBHOOK_URL=
# Fire a reward webhook when a promoter passes this many entries in one afternoon.
PROMOTER_SURGE_THRESHOLD=50

# ─── Membership pricing (cents, ZAR) ───────────────────────────────────────
MEMBERSHIP_PRICE_CENTS=4900
